# Copier en .env (jamais commit, jamais partage). Renseigner les valeurs soi-meme.
BK_DOMAIN=bk-ai-workers.com
BK_PUBLIC_URL=https://bk-ai-workers.com
BK_REQUIRE_GATE=1
# Genere avec : python deploy/make-gate-hash.py
BK_GATE_HASH=
# Cle API Anthropic (sk-ant-...)
BK_SECRET_ANTHROPIC=
# Stripe (une seule ligne JSON) — pricesAnnual optionnel (voir
# deploy/set-stripe-annual-prices.py pour l'ajouter separement) :
# {"secret_key":"sk_live_...","publishable_key":"pk_live_...","prices":{"starter":"price_...","business":"price_...","pro":"price_...","scale":"price_..."},"pricesAnnual":{"starter":"price_...","business":"price_...","pro":"price_...","scale":"price_..."}}
BK_SECRET_STRIPE=
# Solo, Trio et Equipe n'ont PAS besoin de Price ID : le serveur envoie le montant du catalogue (CHF, docs/PRICING.md) a Stripe.
# Un Price ID saisi pour l'un d'eux serait utilise a la place : son montant doit alors etre celui de la grille.
# Coupon de lancement (-30% 2 mois), cree dans Stripe — pas un secret, juste
# un identifiant d'offre. Vide = aucune reduction appliquee. ATTENTION : sur les deux mois remises, le cout IA au pire cas passe de
# environ 33 % a 46-49 % du prix paye (docs/PRICING.md section 5) : ne le renseigner que si cette marge est acceptee.
BK_STRIPE_LAUNCH_COUPON=
# Niveaux de mission (Rapide 1 / Equilibre 6 / Approfondi 12 credits), actifs par defaut (core/ai/LEVELS.json).
# INTERRUPTEUR D'ARRET : BK_LEVELS=0 puis `docker compose up -d` (recree le conteneur) = ancien comportement, un seul
# niveau, modele leger, 1 credit par mission. MESURE D'URGENCE DE COURTE DUREE : ce mode tourne sur un modele 10 fois plus cher par appel
# et depasse 100 % du prix des forfaits au pire cas (docs/PRICING.md section 5). Laisser commente pour garder les niveaux.
# BK_LEVELS=0
# Projets (moteur d'autonomie, docs/AUTONOMY-ENGINE.md) : DORMANT par defaut. 0 = les routes /api/projects* repondent 503 PROJECTS_DISABLED et le
# superviseur ne demarre pas. 1 = actif. RETOUR ARRIERE : BK_PROJECTS=0 puis `docker compose up -d`, ou {"killAll": true} dans
# runtime/projects/_control.json (sans redemarrage). Ne rien annoncer avant la preuve (docs/AUTONOMY-ENGINE.md section 10.6).
# BK_PROJECTS=0
# Liste blanche de ClientId (virgules) pendant le deploiement progressif ; vide = tous quand BK_PROJECTS=1.
# BK_PROJECTS_ALLOW=
# Lanceurs d'etape simultanes (serveur 2 vCPU / 3,8 Go : 2 au global, 1 par client ; Scale et Enterprise : 2).
# BK_PROJECT_STEPS_GLOBAL=2
# BK_PROJECT_STEPS_PER_CLIENT=1
# Options du lanceur d'etape : cache de la conversation (1 par defaut) et compaction cote serveur Anthropic (0 par defaut, en previsualisation).
# BK_PROJECT_CONVO_CACHE=1
# BK_PROJECT_COMPACTION=0
# Interpreteur Python appele par le lanceur d'etape pour les outils de l'espace de travail (defaut : python3 sous Linux, python sous Windows).
# BK_PYTHON=python3
# Limites d'usage comme celles de Claude (docs/PRICING.md section 6) : une limite par SESSION de 4 h (ouverte par la premiere mission,
# renouvelee seule), une limite par SEMAINE, en plus du quota du mois ; aucun forfait n'est illimite. Chiffres : core/usage/USAGE-LIMITS.json.
#   0 (defaut) = inerte : seul le mois borne, aucune reponse, page ni jauge ne change
#   shadow     = le grand livre tourne, RIEN n'est bloque, chaque refus qui aurait eu lieu est journalise (usage_would_block) : 7 jours pour calibrer
#   1          = actif (refus 402 USAGE_LIMIT_REACHED, jauges, pages Tarifs et FAQ). Durcit les conditions des abonnes existants : preavis de 30 jours (CGV).
# Retour arriere : remettre 0 puis `docker compose up -d`.
# BK_USAGE_WINDOWS=0

# Chloe delegue a tous les Workers (docs/CHLOE-DELEGATION.md). Tout est facultatif : les valeurs par defaut conviennent au petit serveur (2 vCPU / 3,8 Go).
# INTERRUPTEUR D'ARRET : BK_CHLOE_PLANNER=0 = ancien routage (mots-cles puis repli IA, tous les Workers retenus recoivent la meme demande).
# BK_CHLOE_PLANNER=0
# BK_CHLOE_EXECUTOR=inline         les Workers d'une mission tournent un par un dans le processus de Chloe (secours)
# BK_CHLOE_PARALLEL=2              Workers en meme temps pour UNE mission (1 a 4)
# BK_CHLOE_SLOTS_GLOBAL=3          Workers en meme temps pour TOUTES les missions de Chloe ensemble (1 a 8) ; les autres attendent leur tour
# BK_CHLOE_DEADLINE_SEC=535        duree maximale d'une mission de Chloe (le serveur coupe a 600 s)
# BK_CHLOE_CONSISTENCY=0           coupe la relecture de coherence entre Workers (1 la force aussi au niveau Rapide)
# BK_CHLOE_ROUTER_MODEL=claude-haiku-5-5   modele de l'appel de decoupage (un appel par mission, quelques millimes de franc)
# BK_ASYNC_QUEUE_MAX_PER_CLIENT=5  missions en arriere-plan en attente de place, par client ; BK_ASYNC_QUEUE_MAX_GLOBAL=20 ; BK_ASYNC_QUEUE_MAX_WAIT=480 secondes

# --- Moteur d'IA (docs/PROVIDERS.md) : un CHOIX par mission. Laisser vide = Claude comme avant. Noms seulement, aucun secret ici.
# Chaine par defaut : anthropic (defaut) | ollama,anthropic | anthropic,ollama | ollama | swiss,anthropic ... (alias : local, claude, suisse)
# BK_AI_PROVIDER=
# Moteur local (Ollama sur VOTRE PC, relie par un reseau prive type Tailscale ; jamais une adresse publique en http) :
# BK_OLLAMA_URL=http://100.x.y.z:11434
# BK_OLLAMA_MODEL=llama3.1:8b
# Hebergeur suisse compatible OpenAI (https + jeton : python3 deploy/set-engine-secret.py swiss) :
# BK_SWISS_URL=
# BK_SWISS_MODEL=
# Jeton Infomaniak, jamais dans engine-settings.json : python3 deploy/set-engine-secret.py swiss
# Recherche web SearXNG prive (si vous utilisez docker-compose.search.yml) :
# Generer une cle avec : openssl rand -hex 32 ; definir SEARXNG_SECRET dans le .env prive.
# BK_SEARCH_URL=http://searxng:8080
# Pour un point de recherche HTTPS externe, enregistrer son jeton avec : python3 deploy/set-engine-secret.py search
# BK_SECRET_SEARCH=
# SEARXNG_SECRET=
# Plafond de depense Claude (CHF) : au-dela, les missions passent sur le moteur gratuit, avec mention ; alerte a 80 % a BK_PILOT_NOTIFY_EMAIL.
# Pour une autre instance SearXNG : remplacer BK_SEARCH_URL ci-dessus ; en HTTPS, ajouter le jeton avec deploy/set-engine-secret.py search.
# BK_CLAUDE_DAILY_CHF=
# BK_CLAUDE_MONTHLY_CHF=
