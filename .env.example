# Copier en .env (jamais commit, jamais partage). Renseigner les valeurs soi-meme.
BK_DOMAIN=bk-ia-workers.com
BK_PUBLIC_URL=https://bk-ia-workers.com
BK_REQUIRE_GATE=1
# Genere avec : python deploy/make-gate-hash.py
BK_GATE_HASH=
# Cle API Anthropic (sk-ant-...)
BK_SECRET_ANTHROPIC=
# Stripe (une seule ligne JSON) — pricesAnnual optionnel (voir
# deploy/set-stripe-annual-prices.py pour l'ajouter separement) :
# {"secret_key":"sk_live_...","publishable_key":"pk_live_...","prices":{"starter":"price_...","business":"price_...","pro":"price_...","scale":"price_..."},"pricesAnnual":{"starter":"price_...","business":"price_...","pro":"price_...","scale":"price_..."}}
BK_SECRET_STRIPE=
# Coupon de lancement (-30% 2 mois), cree dans Stripe — pas un secret, juste
# un identifiant d'offre. Vide = aucune reduction appliquee.
BK_STRIPE_LAUNCH_COUPON=

# Cle maitresse de chiffrement des identifiants connecteurs (AES-256-GCM),
# 32 octets encodes en base64. Generer une fois avec :
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
BK_SECRET_CRED_ENCRYPTION_KEY=

# Reseau / runtime (valeurs par defaut raisonnables ; l'entrypoint force deja
# BK_LISTEN_HOST=0.0.0.0 dans le conteneur, Caddy etant devant).
BK_PORT=8787
BK_LISTEN_HOST=0.0.0.0

# Email transactionnel (OPTIONNEL). Si BK_SMTP_HOST est vide, l'envoi passe par
# le bridge Gmail du proprietaire. Renseigner pour un SMTP dedie en production.
BK_SMTP_HOST=
BK_SMTP_PORT=587
BK_SMTP_USER=
BK_SMTP_PASSWORD=
BK_SMTP_FROM=

# Agent telephonique Twilio (OPTIONNEL). Defaut applicatif :
# https://bk-ai-workers.com/webhooks/twilio/voice
BK_PHONE_WEBHOOK_URL=
