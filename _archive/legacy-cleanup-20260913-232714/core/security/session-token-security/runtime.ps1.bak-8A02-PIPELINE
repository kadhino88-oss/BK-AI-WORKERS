function Get-SHA256TokenHash {
    param(
        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$Token
    )

    if ([string]::IsNullOrWhiteSpace($Token)) {
        return $null
    }

    $sha = New-Object System.Security.Cryptography.SHA256Managed

    try {
        $bytes = [System.Text.Encoding]::UTF8.GetBytes(
            $Token
        )

        return (
            [System.BitConverter]::ToString(
                $sha.ComputeHash($bytes)
            ) -replace "-", ""
        ).ToLowerInvariant()
    }
    finally {
        $sha.Dispose()
    }
}

function Get-SessionTokenRecord {
    param(
        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$TokenId
    )

    if ([string]::IsNullOrWhiteSpace($TokenId)) {
        return $null
    }

    $records = @(Get-SessionTokenRecords)

    foreach ($record in $records) {
        if ([string]$record.TokenId -eq $TokenId) {
            return $record
        }
    }

    return $null
}

