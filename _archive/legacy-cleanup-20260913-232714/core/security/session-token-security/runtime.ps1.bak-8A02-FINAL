function Test-SessionTokenContext {
    param(
        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$TokenId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$SessionId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$UserId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$TenantId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$ClientId
    )

    $cfg = Get-SessionTokenSecurityConfig

    if (-not $cfg.enabled -or -not $cfg.tokenSecurityEnabled) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_SECURITY_DISABLED"
        }
    }

    if ([string]::IsNullOrWhiteSpace($TokenId)) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_ID_REQUIRED"
        }
    }

    if ($cfg.requireSessionBinding) {
        if ([string]::IsNullOrWhiteSpace($SessionId)) {
            return [pscustomobject]@{
                Success = $false
                Status  = "BLOCKED"
                Reason  = "SESSION_ID_REQUIRED"
            }
        }
    }

    if ([string]::IsNullOrWhiteSpace($UserId)) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "USER_ID_REQUIRED"
        }
    }

    if ($cfg.requireTenantBinding) {
        if ([string]::IsNullOrWhiteSpace($TenantId)) {
            return [pscustomobject]@{
                Success = $false
                Status  = "BLOCKED"
                Reason  = "TENANT_ID_REQUIRED"
            }
        }
    }

    if ($cfg.requireClientBinding) {
        if ([string]::IsNullOrWhiteSpace($ClientId)) {
            return [pscustomobject]@{
                Success = $false
                Status  = "BLOCKED"
                Reason  = "CLIENT_ID_REQUIRED"
            }
        }
    }

    return [pscustomobject]@{
        Success = $true
        Status  = "VALID"
        Reason  = "TOKEN_CONTEXT_VALID"
    }
}

function New-SessionSecurityToken {
    param(
        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$TokenId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$SessionId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$UserId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$TenantId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$ClientId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$ProjectId = ""
    )

    $cfg = Get-SessionTokenSecurityConfig

    $check = Test-SessionTokenContext `
        -TokenId $TokenId `
        -SessionId $SessionId `
        -UserId $UserId `
        -TenantId $TenantId `
        -ClientId $ClientId

    if (-not $check.Success) {
        return $check
    }

    if ([string]::IsNullOrWhiteSpace($TokenId)) {
        $TokenId = [guid]::NewGuid().ToString()
    }

    $records = @(Get-SessionTokenRecords)

    foreach ($existing in $records) {
        if ([string]$existing.TokenId -eq $TokenId) {
            return [pscustomobject]@{
                Success = $false
                Status  = "DUPLICATE"
                Reason  = "TOKEN_ID_ALREADY_EXISTS"
                TokenId = $TokenId
            }
        }

        if ([string]$existing.SessionId -eq $SessionId -and
            [string]$existing.Status -eq "ACTIVE") {

            return [pscustomobject]@{
                Success = $false
                Status  = "DUPLICATE"
                Reason  = "ACTIVE_TOKEN_ALREADY_EXISTS_FOR_SESSION"
                SessionId = $SessionId
            }
        }
    }

    if (@($records).Length -ge [int]$cfg.maxTokenRecords) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_RECORD_LIMIT_REACHED"
        }
    }

    # Token brut généré en mémoire uniquement.
    $rawToken = (
        [guid]::NewGuid().ToString("N") +
        [guid]::NewGuid().ToString("N")
    )

    $tokenHash = Get-SHA256TokenHash -Token $rawToken

    $now = [DateTime]::UtcNow
    $expires = $now.AddSeconds(
        [double]$cfg.tokenDurationSeconds
    )

    $record = [pscustomobject]@{
        TokenId       = $TokenId
        SessionId     = $SessionId
        UserId        = $UserId
        TenantId      = $TenantId
        ClientId      = $ClientId
        ProjectId     = $ProjectId
        TokenHash     = $tokenHash
        Status        = "ACTIVE"
        CreatedAtUtc  = $now.ToString("o")
        ExpiresAtUtc  = $expires.ToString("o")
        RotatedFrom   = ""
        RevokedAtUtc  = ""
    }

    $records += ,$record

    $null = Save-SessionTokenRecords $records

    # Le raw token n'est jamais stocké ni retourné dans l'état.
    return [pscustomobject]@{
        Success      = $true
        Status       = "CREATED"
        Reason       = "TOKEN_CREATED"
        TokenId      = $TokenId
        SessionId    = $SessionId
        UserId       = $UserId
        TenantId     = $TenantId
        ClientId     = $ClientId
        ProjectId    = $ProjectId
        Token        = $rawToken
        TokenHash    = $tokenHash
        ExpiresAtUtc = $expires.ToString("o")
    }
}

function Test-SessionSecurityToken {
    param(
        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$TokenId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$Token,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$SessionId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$UserId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$TenantId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$ClientId,

        [Parameter(Mandatory=$false)]
        [datetime]$ReferenceTime = [DateTime]::UtcNow
    )

    $cfg = Get-SessionTokenSecurityConfig

    if (-not $cfg.tokenSecurityEnabled) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_SECURITY_DISABLED"
        }
    }

    if ([string]::IsNullOrWhiteSpace($TokenId)) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_ID_REQUIRED"
        }
    }

    if ([string]::IsNullOrWhiteSpace($Token)) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "RAW_TOKEN_REQUIRED"
        }
    }

    $record = Get-SessionTokenRecord `
        -TokenId $TokenId

    if ($null -eq $record) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_NOT_FOUND"
        }
    }

    if ([string]$record.SessionId -ne [string]$SessionId) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_SESSION_MISMATCH"
        }
    }

    if ([string]$record.UserId -ne [string]$UserId) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_USER_MISMATCH"
        }
    }

    if ([string]$record.TenantId -ne [string]$TenantId) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_TENANT_MISMATCH"
        }
    }

    if ([string]$record.ClientId -ne [string]$ClientId) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_CLIENT_MISMATCH"
        }
    }

    if ($record.Status -eq "REVOKED" -and
        -not $cfg.allowRevokedToken) {

        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_REVOKED"
        }
    }

    try {
        $expires = [DateTime]::Parse(
            [string]$record.ExpiresAtUtc
        )
    }
    catch {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_EXPIRATION_INVALID"
        }
    }

    if ($cfg.sessionExpirationEnabled -and
        $ReferenceTime -ge $expires -and
        -not $cfg.allowExpiredToken) {

        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_EXPIRED"
        }
    }

    $calculatedHash = Get-SHA256TokenHash -Token $Token

    if ($calculatedHash -ne [string]$record.TokenHash) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_HASH_MISMATCH"
        }
    }

    return [pscustomobject]@{
        Success   = $true
        Status    = "VALID"
        Reason    = "TOKEN_VALID"
        TokenId   = $record.TokenId
        SessionId = $record.SessionId
        UserId    = $record.UserId
        TenantId  = $record.TenantId
        ClientId  = $record.ClientId
        ProjectId = $record.ProjectId
        ExpiresAtUtc = $expires.ToString("o")
    }
}

function Revoke-SessionSecurityToken {
    param(
        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$TokenId
    )

    if ([string]::IsNullOrWhiteSpace($TokenId)) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_ID_REQUIRED"
        }
    }

    $records = @(Get-SessionTokenRecords)

    foreach ($record in $records) {

        if ([string]$record.TokenId -eq $TokenId) {

            if ([string]$record.Status -eq "REVOKED") {
                return [pscustomobject]@{
                    Success = $false
                    Status  = "DUPLICATE"
                    Reason  = "TOKEN_ALREADY_REVOKED"
                }
            }

            $record.Status = "REVOKED"

            $revokedAt = [DateTime]::UtcNow.ToString("o")

            if ($null -eq $record.PSObject.Properties["RevokedAtUtc"]) {
                $record | Add-Member `
                    -MemberType NoteProperty `
                    -Name "RevokedAtUtc" `
                    -Value $revokedAt `
                    -Force
            }
            else {
                $record.RevokedAtUtc = $revokedAt
            }

            $null = Save-SessionTokenRecords $records

            return [pscustomobject]@{
                Success = $true
                Status  = "REVOKED"
                Reason  = "TOKEN_REVOKED"
                TokenId = $TokenId
                RevokedAtUtc = $revokedAt
            }
        }
    }

    return [pscustomobject]@{
        Success = $false
        Status  = "BLOCKED"
        Reason  = "TOKEN_NOT_FOUND"
    }
}

function Rotate-SessionSecurityToken {
    param(
        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$TokenId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$SessionId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$UserId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$TenantId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$ClientId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$ProjectId = ""
    )

    $record = Get-SessionTokenRecord `
        -TokenId $TokenId

    if ($null -eq $record) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_NOT_FOUND"
        }
    }

    $contextCheck = Test-SessionTokenContext `
        -TokenId $TokenId `
        -SessionId $SessionId `
        -UserId $UserId `
        -TenantId $TenantId `
        -ClientId $ClientId

    if (-not $contextCheck.Success) {
        return $contextCheck
    }

    if ([string]$record.Status -ne "ACTIVE") {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TOKEN_NOT_ACTIVE"
        }
    }

    $null = Revoke-SessionSecurityToken `
        -TokenId $TokenId

    $newToken = New-SessionSecurityToken `
        -SessionId $SessionId `
        -UserId $UserId `
        -TenantId $TenantId `
        -ClientId $ClientId `
        -ProjectId $ProjectId

    if (-not $newToken.Success) {
        return $newToken
    }

    $records = @(Get-SessionTokenRecords)

    foreach ($item in $records) {

        if ([string]$item.TokenId -eq [string]$newToken.TokenId) {

            if ($null -eq $item.PSObject.Properties["RotatedFrom"]) {
                $item | Add-Member `
                    -MemberType NoteProperty `
                    -Name "RotatedFrom" `
                    -Value $TokenId `
                    -Force
            }
            else {
                $item.RotatedFrom = $TokenId
            }
        }
    }

    $null = Save-SessionTokenRecords $records

    return $newToken | Add-Member `
        -MemberType NoteProperty `
        -Name "RotatedFrom" `
        -Value $TokenId `
        -PassThru
}

function New-SessionSecurityBinding {
    param(
        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$SessionId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$UserId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$TenantId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$ClientId,

        [Parameter(Mandatory=$false)]
        [AllowEmptyString()]
        [string]$ProjectId = ""
    )

    $cfg = Get-SessionTokenSecurityConfig

    if ([string]::IsNullOrWhiteSpace($SessionId)) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "SESSION_ID_REQUIRED"
        }
    }

    if ([string]::IsNullOrWhiteSpace($UserId)) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "USER_ID_REQUIRED"
        }
    }

    if ($cfg.requireTenantBinding -and
        [string]::IsNullOrWhiteSpace($TenantId)) {

        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "TENANT_ID_REQUIRED"
        }
    }

    if ($cfg.requireClientBinding -and
        [string]::IsNullOrWhiteSpace($ClientId)) {

        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "CLIENT_ID_REQUIRED"
        }
    }

    $records = @(Get-SessionSecurityRecords)

    foreach ($record in $records) {

        if ([string]$record.SessionId -eq $SessionId) {
            return [pscustomobject]@{
                Success = $false
                Status  = "DUPLICATE"
                Reason  = "SESSION_BINDING_ALREADY_EXISTS"
            }
        }
    }

    $cfg = Get-SessionTokenSecurityConfig

    if (@($records).Length -ge [int]$cfg.maxSessions) {
        return [pscustomobject]@{
            Success = $false
            Status  = "BLOCKED"
            Reason  = "SESSION_LIMIT_REACHED"
        }
    }

    $record = [pscustomobject]@{
        SessionId    = $SessionId
        UserId       = $UserId
        TenantId     = $TenantId
        ClientId     = $ClientId
        ProjectId    = $ProjectId
        Status       = "ACTIVE"
        CreatedAtUtc = [DateTime]::UtcNow.ToString("o")
    }

    $records += ,$record

    $null = Save-SessionSecurityRecords $records

    return [pscustomobject]@{
        Success   = $true
        Status    = "BOUND"
        Reason    = "SESSION_BOUND"
        SessionId = $SessionId
        UserId    = $UserId
        TenantId  = $TenantId
        ClientId  = $ClientId
        ProjectId = $ProjectId
    }
}

function Reset-SessionTokenSecurity {
    $null = Save-SessionTokenRecords @()
    $null = Save-SessionSecurityRecords @()
    return $true
}