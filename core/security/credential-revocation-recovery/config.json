{
  "version": "1.0",
  "system": "BK-AI-WORKERS",
  "module": "8A-23",
  "name": "Credential Revocation Recovery Guard",
  "enabled": true,
  "recoveryGuardEnabled": true,
  "newChainRequired": true,
  "oldChainImmutable": true,
  "blockRevokedChainRecovery": true,
  "blockStaleBindingRecovery": true,
  "failClosed": true,
  "requireCredentialBinding": true,
  "requireParentRevocationReference": true,
  "requireNewChainId": true,
  "requireNewLeaseId": true,
  "requireNewMaterializationId": true,
  "requireNewUsageId": true,
  "requireNewExecutionId": true,
  "neverPersistRawSecrets": true,
  "neverPersistRawCredentials": true,
  "persistSecretMaterial": false,
  "maxRecords": 100000,
  "defaultDecision": "BLOCK",
  "liveExecutionEnabled": false
}
