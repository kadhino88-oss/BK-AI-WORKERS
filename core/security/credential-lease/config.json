{
  "version":"1.0",
  "system":"BK-AI-WORKERS",
  "enabled":true,
  "credentialLeaseEnabled":true,
  "timeBoundLeaseEnabled":true,
  "singleUseLeaseEnabled":true,
  "failClosed":true,
  "requireCredentialAuthorization":true,
  "requireTenantBinding":true,
  "requireClientBinding":true,
  "requireProjectBinding":true,
  "requireWorkerBinding":true,
