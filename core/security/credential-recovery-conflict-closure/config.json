{
  "version": "1.0",
  "system": "BK-AI-WORKERS",
  "module": "8A-39",
  "name": "Revocation Conflict Closure & Immutable Recovery Guard",
  "enabled": true,
  "closureEnabled": true,
  "immutableClosureEnabled": true,
  "failClosed": true,
  "requireResolvedConflict": true,
  "requireRevokedResolution": true,
  "requireBlockedExecution": true,
  "requireTenantBinding": true,
  "requireExecutionBinding": true,
  "requireIntegrityHash": true,
  "blockReopen": true,
  "blockMutation": true,
  "blockReactivation": true,
  "blockResolutionRewrite": true,
  "oneWayClosure": true,
  "immutableFinalState": true,
  "neverPersistRawSecrets": true,
  "neverPersistRawCredentials": true,
  "persistSecretMaterial": false,
  "maxRecords": 100000,
  "defaultDecision": "BLOCK"
}
