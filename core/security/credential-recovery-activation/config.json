{
  "version": "1.0",
  "system": "BK-AI-WORKERS",
  "module": "8A-26",
  "name": "Credential Recovery Fresh-Chain Activation Guard",
  "enabled": true,
  "activationGuardEnabled": true,
  "requireRecoveryAuthorization": true,
  "requireContextRevalidation": true,
  "requireFreshChain": true,
  "requireFreshLease": true,
  "requireFreshMaterialization": true,
  "requireFreshUsage": true,
  "requireFreshExecution": true,
  "blockOldChainReuse": true,
  "blockCrossTenantActivation": true,
  "blockCrossClientActivation": true,
  "blockCrossProjectActivation": true,
  "singleUseActivationEnabled": true,
  "failClosed": true,
  "neverPersistRawSecrets": true,
  "neverPersistRawCredentials": true,
  "persistSecretMaterial": false,
  "maxRecords": 100000,
  "defaultDecision": "BLOCK",
  "liveExecutionEnabled": false
}
