{
  "version":"1.0",
  "system":"BK-AI-WORKERS",
  "enabled":true,
  "delegationIntegrityEnabled":true,
  "antiPrivilegeTransferEnabled":true,
  "failClosed":true,
  "requireParentAuthority":true,
  "requireSameUser":true,
  "requireSameTenant":true,
  "requireSameClient":true,
  "requireSameProject":true,
  "requireSameWorker":true,
  "requireParentActive":true,
  "rejectCrossWorkerDelegation":true,
  "rejectCrossProjectDelegation":true,
  "rejectParentReuse":true,
  "requireRevocationChain":true,
  "requireFreshnessValidation":true,
  "requireContextIntegrity":true,
  "defaultDecision":"BLOCK",
  "maxRecords":100000,
  "captureSecrets":false,
  "capturePayloads":false,
  "liveExecutionEnabled":false
}