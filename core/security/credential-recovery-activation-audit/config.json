{
  "version": "1.0",
  "system": "BK-AI-WORKERS",
  "module": "8A-28",
  "name": "Credential Recovery Activation Audit & Lifecycle Guard",
  "enabled": true,
  "auditEnabled": true,
  "lifecycleGuardEnabled": true,
  "correlationEnabled": true,
  "hashChainEnabled": true,
  "immutableEventsEnabled": true,
  "failClosed": true,
  "requireActivationBinding": true,
  "requireAuthorizationBinding": true,
  "requireContextBinding": true,
  "requireNewChainBinding": true,
  "requireEventCorrelation": true,
  "blockInvalidLifecycleTransition": true,
  "blockPostConsumeReuse": true,
  "neverPersistRawSecrets": true,
  "neverPersistRawCredentials": true,
  "persistSecretMaterial": false,
  "maxRecords": 100000,
  "defaultDecision": "BLOCK",
  "liveExecutionEnabled": false
}
