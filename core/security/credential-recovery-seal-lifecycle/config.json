{
  "version": "1.0",
  "system": "BK-AI-WORKERS",
  "module": "8A-42",
  "name": "Global Security Seal Revocation & Lifecycle Guard",
  "enabled": true,
  "lifecycleEnabled": true,
  "revocationEnabled": true,
  "closureEnabled": true,
  "failClosed": true,
  "requireSealIdentity": true,
  "requireTenantBinding": true,
  "requireExecutionBinding": true,
  "requireSealIntegrity": true,
  "allowActiveState": true,
  "blockExpiredState": true,
  "blockRevokedState": true,
  "blockClosedState": true,
  "blockReactivation": true,
  "blockReopen": true,
  "blockReuse": true,
  "oneWayLifecycle": true,
  "permanentClosure": true,
  "neverPersistRawSecrets": true,
  "neverPersistRawCredentials": true,
  "persistSecretMaterial": false,
  "maxRecords": 100000,
  "defaultDecision": "BLOCK"
}
