{
  "version":"1.0",
  "system":"BK-AI-WORKERS",
  "enabled":true,
  "privilegeBoundaryEnabled":true,
  "scopeHierarchyEnabled":true,
  "failClosed":true,
  "requireRevocationChain":true,
  "requireFreshnessValidation":true,
  "requireContextIntegrity":true,
  "allowDownwardScopeOnly":true,
  "allowSameScopeOnlyWhenIdsMatch":true,
  "allowCrossTenant":false,
  "allowCrossClient":false,
  "allowCrossProject":false,
  "allowedScopes":[
    "KADER",
    "TENANT",
    "CLIENT",
    "PROJECT",
    "WORKER",
    "TASK"
  ],
  "allowedActions":[
    "READ",
    "WRITE",
    "EXECUTE",
    "APPROVE",
    "DELETE",
    "MANAGE_USERS",
    "MANAGE_ROLES",
    "MANAGE_CONNECTORS",
    "MANAGE_BILLING"
  ],
  "defaultDecision":"BLOCK",
  "maxRecords":100000,
  "captureSecrets":false,
  "capturePayloads":false,
  "liveExecutionEnabled":false
}