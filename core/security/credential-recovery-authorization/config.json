{
  "version": "1.0",
  "system": "BK-AI-WORKERS",
  "module": "8A-24",
  "name": "Credential Recovery Authorization & Fresh-Chain Binding Guard",
  "enabled": true,
  "recoveryAuthorizationEnabled": true,
  "freshChainBindingEnabled": true,
  "failClosed": true,
  "requireParentRecoveryReference": true,
  "requireUserBinding": true,
  "requireTenantBinding": true,
  "requireClientBinding": true,
  "requireProjectBinding": true,
  "requireWorkerBinding": true,
  "requireActionBinding": true,
  "requireConnectorBinding": true,
  "requireNewChainId": true,
  "requireNewLeaseId": true,
  "requireNewMaterializationId": true,
  "requireNewUsageId": true,
  "requireNewExecutionId": true,
  "blockContextSubstitution": true,
  "blockCrossTenantRecovery": true,
  "blockCrossClientRecovery": true,
  "blockCrossProjectRecovery": true,
  "singleUseAuthorizationEnabled": true,
  "neverPersistRawSecrets": true,
  "neverPersistRawCredentials": true,
  "persistSecretMaterial": false,
  "maxRecords": 100000,
  "defaultDecision": "BLOCK",
  "liveExecutionEnabled": false
}
