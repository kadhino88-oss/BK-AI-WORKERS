{
  "version":"1.0",
  "system":"BK-AI-WORKERS",
  "enabled":true,
  "credentialAccessAuthorizationEnabled":true,
  "leastPrivilegeEnabled":true,
  "failClosed":true,
  "requireTenantBinding":true,
  "requireClientBinding":true,
  "requireProjectBinding":true,
  "requireWorkerBinding":true,
  "requireActionBinding":true,
  "requireConnectorBinding":true,
  "requireRevocationChain":true,
  "requireFreshnessValidation":true,
  "requireContextIntegrity":true,
  "neverPersistRawSecrets":true,
  "neverReturnRawSecrets":true,
  "hashSecretReferences":true,
  "sensitiveActionApprovalRequired":true,
  "defaultDecision":"BLOCK",
  "maxRecords":100000,
  "captureSecrets":false,
  "capturePayloads":false,
  "liveExecutionEnabled":false
}