{
  "version": "1.0",
  "system": "BK-AI-WORKERS",
  "module": "8A-34",
  "name": "Final Enforcement Anti-Replay & One-Time Use Guard",
  "enabled": true,
  "antiReplayEnabled": true,
  "oneTimeUseEnabled": true,
  "failClosed": true,
  "requireEnforcedState": true,
  "requireExecutionBinding": true,
  "requireContextBinding": true,
  "requireTenantBinding": true,
  "requireFreshNonce": true,
  "requireIntegrityHash": true,
  "blockReplay": true,
  "blockExecutionReuse": true,
  "blockContextReuse": true,
  "blockCrossTenantReuse": true,
  "blockNonceReuse": true,
  "consumeOnSuccess": true,
  "neverPersistRawSecrets": true,
  "neverPersistRawCredentials": true,
  "persistSecretMaterial": false,
  "maxRecords": 100000,
  "defaultDecision": "BLOCK"
}
