{
  "version": "1.0",
  "system": "BK-AI-WORKERS",
  "module": "8A-37",
  "name": "Revocation Propagation & Cross-Module Synchronization Guard",
  "enabled": true,
  "propagationEnabled": true,
  "synchronizationEnabled": true,
  "failClosed": true,
  "requireSourceRevocation": true,
  "requireEnforcementSync": true,
  "requireConsumptionSync": true,
  "requireAuthorizationSync": true,
  "requireExecutionSync": true,
  "requireTenantBinding": true,
  "requireExecutionBinding": true,
  "blockPartialPropagation": true,
  "blockStateDrift": true,
  "blockContradictoryState": true,
  "blockStaleAuthorization": true,
  "blockStaleExecution": true,
  "oneWayPropagation": true,
  "reactivationAllowed": false,
  "reopenAllowed": false,
  "neverPersistRawSecrets": true,
  "neverPersistRawCredentials": true,
  "persistSecretMaterial": false,
  "maxRecords": 100000,
  "defaultDecision": "BLOCK"
}
