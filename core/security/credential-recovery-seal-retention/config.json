{
  "version": "1.0",
  "system": "BK-AI-WORKERS",
  "module": "8A-44",
  "name": "Global Security Seal Evidence Retention & Integrity Guard",
  "enabled": true,
  "retentionEnabled": true,
  "integrityEnabled": true,
  "availabilityEnabled": true,
  "failClosed": true,
  "requireEvidenceIdentity": true,
  "requireSealIdentity": true,
  "requireTenantBinding": true,
  "requireExecutionBinding": true,
  "requirePermanentEvidence": true,
  "requireImmutableEvidence": true,
  "requireHashIntegrity": true,
  "requireRetentionState": true,
  "requireAvailabilityState": true,
  "blockEvidenceDeletion": true,
  "blockEvidenceMutation": true,
  "blockEvidenceRewrite": true,
  "blockPrematureExpiration": true,
  "blockRetentionBypass": true,
  "appendOnly": true,
  "permanentEvidence": true,
  "defaultRetentionState": "RETAINED",
  "defaultDecision": "BLOCK",
  "neverPersistRawSecrets": true,
  "neverPersistRawCredentials": true,
  "persistSecretMaterial": false,
  "maxRecords": 100000
}
