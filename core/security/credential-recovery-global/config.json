{
  "version": "1.0",
  "system": "BK-AI-WORKERS",
  "module": "8A-30",
  "name": "Credential Recovery Global Consistency Guard",
  "enabled": true,
  "globalConsistencyEnabled": true,
  "failClosed": true,
  "requireRecoveryGuard": true,
  "requireAuthorizationGuard": true,
  "requireContextGuard": true,
  "requireActivationGuard": true,
  "requireActivationIntegrity": true,
  "requireActivationAudit": true,
  "requireCompletionGuard": true,
  "requireOldChainRevoked": true,
  "requireNewChainActive": true,
  "requireNewLeaseActive": true,
  "requireNewMaterializationActive": true,
  "requireNewUsageActive": true,
  "requireNewExecutionAuthorized": true,
  "blockPartialRecovery": true,
  "blockCrossTenantRecovery": true,
  "blockStaleRecovery": true,
  "neverPersistRawSecrets": true,
  "neverPersistRawCredentials": true,
  "persistSecretMaterial": false,
  "maxRecords": 100000,
  "defaultDecision": "BLOCK",
  "liveExecutionEnabled": false
}
