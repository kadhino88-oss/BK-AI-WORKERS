{
  "version": "1.0",
  "system": "BK-AI-WORKERS",
  "module": "8A-38",
  "name": "Revocation Sync Conflict & Drift Resolution Guard",
  "enabled": true,
  "conflictDetectionEnabled": true,
  "driftDetectionEnabled": true,
  "resolutionEnabled": true,
  "failClosed": true,
  "requireSameEnforcementId": true,
  "requireSameRecoveryId": true,
  "requireSameTenantId": true,
  "requireSameExecutionId": true,
  "requireRevokedSource": true,
  "requireBlockedExecution": true,
  "blockConflicts": true,
  "blockStateDrift": true,
  "blockContradictoryState": true,
  "blockStaleState": true,
  "deterministicResolution": true,
  "revokedStateWins": true,
  "reactivationAllowed": false,
  "reopenAllowed": false,
  "defaultDecision": "BLOCK",
  "neverPersistRawSecrets": true,
  "neverPersistRawCredentials": true,
  "persistSecretMaterial": false,
  "maxRecords": 100000
}
