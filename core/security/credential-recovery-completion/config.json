{
  "version": "1.0",
  "system": "BK-AI-WORKERS",
  "module": "8A-29",
  "name": "Credential Recovery Completion & State Consistency Guard",
  "enabled": true,
  "completionGuardEnabled": true,
  "stateConsistencyEnabled": true,
  "failClosed": true,
  "requireAuthorizationBinding": true,
  "requireContextBinding": true,
  "requireActivationBinding": true,
  "requireFreshChain": true,
  "requireFreshLease": true,
  "requireFreshMaterialization": true,
  "requireFreshUsage": true,
  "requireFreshExecution": true,
  "oldChainMustRemainRevoked": true,
  "oldBindingsMustRemainBlocked": true,
  "newChainMustBeActive": true,
  "completionMustBeSingleUse": true,
  "neverPersistRawSecrets": true,
  "neverPersistRawCredentials": true,
  "persistSecretMaterial": false,
  "maxRecords": 100000,
  "defaultDecision": "BLOCK",
  "liveExecutionEnabled": false
}
