{
  "version": "1.0",
  "system": "BK-AI-WORKERS",
  "module": "8A-21",
  "name": "Credential Revocation Audit & Trace Guard",
  "enabled": true,
  "auditEnabled": true,
  "traceCorrelationEnabled": true,
  "hashChainEnabled": true,
  "immutableEventsEnabled": true,
  "failClosed": true,
  "requireCredentialBinding": true,
  "requireLeaseBinding": true,
  "requireMaterializationBinding": true,
  "requireUsageBinding": true,
  "requireExecutionBinding": true,
  "requireWorkerBinding": true,
  "requireActionBinding": true,
  "requireConnectorBinding": true,
  "requireProjectBinding": true,
  "requireClientBinding": true,
  "requireTenantBinding": true,
  "neverPersistRawSecrets": true,
  "neverPersistRawCredentials": true,
  "persistSecretMaterial": false,
  "maxRecords": 100000,
  "defaultDecision": "BLOCK",
  "liveExecutionEnabled": false
}
