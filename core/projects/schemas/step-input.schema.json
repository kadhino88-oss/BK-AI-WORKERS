{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "BK-STEP-INPUT-V1",
  "title": "input.json du lanceur d'etape (ecrit par Python ; docs/AUTONOMY-ENGINE.md, section 7.7). AUCUN secret.",
  "type": "object",
  "required": ["schema", "projectId", "clientId", "stepId", "attempt", "kind", "worker", "phase", "model", "maxIterations", "ceilingChf", "deadlineUtc", "hardDeadlineUtc", "paths", "tools"],
  "properties": {
    "schema": {"const": "BK-STEP-INPUT-V1"},
    "projectId": {"type": "string", "pattern": "^PRJ-[0-9A-F]{32}$"},
    "clientId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
    "stepId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,20}$"},
    "attempt": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["plan", "execute", "fix", "verify", "replan", "consolidate", "answer"]},
    "worker": {"type": "string", "pattern": "^[a-z]{2,20}$"},
    "phase": {"enum": ["plan", "execute", "execute_bulk", "execute_deep", "verify", "replan", "consolidate"]},
    "model": {"type": "string"},
    "effort": {"type": ["string", "null"]},
    "maxIterations": {"type": "integer", "minimum": 1, "maximum": 60},
    "webMaxUses": {"type": "integer", "minimum": 0},
    "callTimeoutSec": {"type": "integer", "minimum": 10},
    "ceilingChf": {"type": "number", "minimum": 0},
    "deadlineUtc": {"type": "string"},
    "hardDeadlineUtc": {"type": "string"},
    "paths": {"type": "object", "required": ["projectDir", "workspace", "stepDir", "spool", "context"]},
    "tools": {"type": "array", "items": {"type": "string"}},
    "connectors": {"type": "array", "items": {"type": "string"}},
    "inputFiles": {"type": "array", "maxItems": 8, "items": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}, "as": {"enum": ["container_upload", "document", "image"]}}}},
    "recipeBlock": {"type": ["string", "null"]},
    "resumeNote": {"type": ["string", "null"]},
    "contextShrink": {"type": "boolean"},
    "language": {"type": "string"},
    "autoApproveSafeOps": {"type": "boolean"},
    "installationPaused": {"type": "boolean"}
  }
}
