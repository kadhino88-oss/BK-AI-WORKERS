{
  "version": "1.0",
  "system": "BK-AI-WORKERS",
  "enabled": true,
  "auditGuardEnabled": true,
  "traceGuardEnabled": true,
  "requireDeliveryContext": true,
  "requireCorrelationId": true,
  "requireRecoveryId": true,
  "requireAuthorizationId": true,
  "requireFinalizationId": true,
  "requireClosureId": true,
  "allowedLifecycle": [
    "AUTHORIZED",
    "RECOVERING",
    "CONSISTENT",
    "FINALIZED",
    "CLOSED"
  ],
  "maxEvents": 20000,
  "captureSecrets": false,
  "capturePayloads": false,
  "liveExecutionEnabled": false
}