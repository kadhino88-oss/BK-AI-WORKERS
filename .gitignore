# BK AI WORKERS - SECRET BOUNDARY

.secrets/
*.secret
*.secrets
.env
.env.*
!.env.example

# Local tool state / runtime data (not part of the product source,
# regenerated at runtime, may contain local test data or PII)
.bk-mcp/
.claude/
/runtime/
memory/runtime/
dashboard/.gate
core/accounts/data/
**/backups
**/*.bak

# OS / editor junk
.DS_Store
Thumbs.db
*.log
# Python bytecode (regenere a chaque execution, depend de la version de Python)
__pycache__/
*.pyc
# Applications mobiles (docs/MOBILE-APPS.md) : cles de signature = SECRETS, jamais dans le depot
*.keystore
*.jks
*.p12
*.mobileprovision
mobile/**/node_modules/
